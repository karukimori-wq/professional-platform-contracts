{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-platform-contracts.local/schemas/events/ai.activity.completed.v1.schema.json",
  "title": "ai.activity.completed.v1",
  "allOf": [
    { "$ref": "./event-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ai.activity.completed.v1" },
        "sourceSystem": { "const": "ai-platform-core" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activityId", "capabilityName", "status"],
          "properties": {
            "activityId": { "type": "string", "pattern": "^act_[A-Za-z0-9_-]+$" },
            "capabilityName": { "type": "string" },
            "status": { "const": "completed" },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "domainRefs": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  ]
}
