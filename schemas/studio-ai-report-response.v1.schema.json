{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-platform-contracts/schemas/studio-ai-report-response.v1.schema.json",
  "title": "Studio AI Report Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "generationId", "correlationId", "draftType", "title", "lead", "sections", "closing", "promptKey", "promptVersion", "knowledgeVersions", "model", "generatedAt", "usage", "warnings"],
  "properties": {
    "status": { "type": "string", "enum": ["success", "warning"] },
    "generationId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string" },
    "correlationId": { "type": "string", "minLength": 1 },
    "draftType": { "const": "ai_draft" },
    "title": { "type": "string", "minLength": 1 },
    "lead": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "heading", "body"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "closing": { "type": "string" },
    "promptKey": { "type": "string", "minLength": 1 },
    "promptVersion": { "type": "string", "minLength": 1 },
    "knowledgeVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knowledgeKey", "version"],
        "properties": {
          "knowledgeKey": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokensApprox", "outputTokensApprox", "usageRecorded"],
      "properties": {
        "inputTokensApprox": { "type": "integer", "minimum": 0 },
        "outputTokensApprox": { "type": "integer", "minimum": 0 },
        "usageRecorded": { "type": "boolean" },
        "usagePeriod": { "type": "string" },
        "usageCount": { "type": "integer", "minimum": 0 },
        "limit": { "type": ["integer", "null"], "minimum": 0 },
        "overLimit": { "type": "boolean" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
