{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-platform-contracts/schemas/studio-ai-report-request.v1.schema.json",
  "title": "Studio AI Report Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "appName", "workspaceId", "userId", "sessionId", "planId", "featureKey", "correlationId", "locale", "characterSnapshot", "consultationRequest", "divination", "confirmedResult", "outputFormat"],
  "properties": {
    "contractVersion": { "const": "studio-ai-report.v1" },
    "appName": { "const": "numeria-studio" },
    "appVersion": { "type": "string", "minLength": 1 },
    "workspaceId": { "type": "string", "minLength": 1 },
    "userId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "enum": ["free", "pro", "business"] },
    "featureKey": { "type": "string", "const": "numeria.report.ai_generate" },
    "traceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "characterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "type", "characterVersion", "name"],
      "properties": {
        "characterId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["preset", "custom"] },
        "characterVersion": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated compatibility alias. New implementations must use characterVersion."
        },
        "name": { "type": "string", "minLength": 1 },
        "personality": { "type": "string" },
        "speakingStyle": { "type": "string" },
        "writingRules": { "type": "array", "items": { "type": "string" } },
        "customInstruction": { "type": "string" }
      }
    },
    "consultationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "theme": { "type": "string" },
        "backgroundSummary": { "type": "string" },
        "appraisalClientSnapshotRef": { "type": "string" },
        "appraisalClientSnapshot": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional Numeria-owned snapshot or summary. Must not be a Growth Engine Customer master copy."
        }
      }
    },
    "divination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["methodKey", "displayName"],
            "properties": {
              "methodKey": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "version": { "type": "string" }
            }
          }
        }
      }
    },
    "confirmedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "results"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["methodKey", "resultKey", "data"],
            "properties": {
              "methodKey": { "type": "string", "minLength": 1 },
              "resultKey": { "type": "string", "minLength": 1 },
              "data": { "type": "object", "additionalProperties": true },
              "confirmedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "outputFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatKey", "sections"],
      "properties": {
        "formatKey": { "type": "string", "minLength": 1 },
        "tone": { "type": "string" },
        "length": { "type": "string", "enum": ["short", "standard", "detailed"] },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "heading"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "heading": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
