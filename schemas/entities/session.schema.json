{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://professional-platform-contracts.local/schemas/entities/session.schema.json",
  "title": "Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "workspaceId", "professionalId", "customerId", "status", "createdAt", "updatedAt"],
  "properties": {
    "sessionId": { "type": "string", "pattern": "^ses_[A-Za-z0-9_-]+$" },
    "workspaceId": { "type": "string", "pattern": "^wks_[A-Za-z0-9_-]+$" },
    "professionalId": { "type": "string", "pattern": "^pro_[A-Za-z0-9_-]+$" },
    "customerId": { "type": "string", "pattern": "^cus_[A-Za-z0-9_-]+$" },
    "studioType": { "type": "string", "enum": ["numeria"] },
    "status": {
      "type": "string",
      "enum": ["draft", "scheduled", "completed", "cancelled"]
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
